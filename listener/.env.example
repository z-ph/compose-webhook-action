WEBHOOK_TOKEN=change-me-to-a-long-random-string
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=19090
WEBHOOK_DRY_RUN=0

# compose 工作目录（仓库根）
COMPOSE_WORKDIR=D:/git/zb
COMPOSE_FILE=docker/docker-compose.yml
COMPOSE_ENV=docker/.env
COMPOSE_ARGS=up --build -d
GIT_PULL=1

# 飞书部署通知（可选）。GitHub Action 通常通过 /hook body 传入，这里作服务端兜底：
# 当 /hook 未带飞书配置时，listener 用这里的值发成功/失败通知。
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# FEISHU_SECRET=飞书机器人加签密钥（与 webhook 同侧，可留空）
